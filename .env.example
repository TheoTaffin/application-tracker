# Copy to .env with `make env`, which also generates random secrets.
# .env is gitignored; never commit real values.

# --- Database (docker compose) ---
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tracker

# --- Object storage (S3 API, served by RustFS locally) ---
S3_BUCKET=tracker-files
S3_ACCESS_KEY_ID=tracker
S3_SECRET_ACCESS_KEY=change-me-too

# --- Published ports (all bound to 127.0.0.1) ---
WEB_PORT=3000
# make tools
ADMINER_PORT=8080
STORAGE_CONSOLE_PORT=9001
# make dev
DEV_DB_PORT=5432
DEV_STORAGE_PORT=9000

# --- Host-side development only (`make dev` + `npm run dev`) ---
# Inside compose these are derived from the values above; on the host, Next.js reads
# them from this file. Keep the credentials in sync with the values above.
DATABASE_URL=postgres://tracker:change-me@127.0.0.1:5432/tracker
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
